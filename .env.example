# ─────────────────────────────────────────────────────────────
#  UPSTREAM — سایتِ کلینیک که وب‌هوک‌ها را دارد
#  (این پروژه فقط واسط است؛ هیچ داده‌ای از کلینیک اینجا ذخیره نمی‌شود)
# ─────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://nafasbeautyclinic.ir
WEBHOOK_USERNAME=webhook-bot@nafasbeautyclinic.ir
WEBHOOK_PASSWORD=ChangeMe-Strong-Password-1!

# ─────────────────────────────────────────────────────────────
#  OPENROUTER — فقط مدل‌های :free
#  لیست زندهٔ مدل‌های مجانی:  npm run models
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODELS=liquid/lfm-3-1.7b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,google/gemma-4-26b-a4b-it:free
MODEL_TIMEOUT_MS=45000
MODEL_RETRIES=2

# ─────────────────────────────────────────────────────────────
#  DOWNSTREAM — پروژهٔ ورسلی که این واسط را صدا می‌زند
# ─────────────────────────────────────────────────────────────
# اگر پر شود، همهٔ مسیرها فقط با هدر x-bot-key (یا Bearer) جواب می‌دهند.
BOT_API_KEY=
# دامنه‌هایی که اجازهٔ صدا زدن از مرورگر دارند (CORS). با کاما. * = همه.
# مثال: https://nafasbeautyclinic.ir,https://admin.nafasbeautyclinic.ir
ALLOWED_ORIGINS=
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000
ALLOW_AUTO_WRITE=false
DEFAULT_LOCALE=fa
PUBLIC_APP_URL=https://ai-webhook-bot.vercel.app

# ─────────────────────────────────────────────────────────────
#  TELEGRAM — ربات تلگرام (اختیاری ولی پیشنهاد می‌شود)
#  ۱) در تلگرام به @BotFather پیام بده: /newbot
#  ۲) توکن را اینجا بگذار
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# یک رشتهٔ تصادفی؛ تلگرام در هر درخواست برمی‌گرداند و ما با آن جعلی‌ها را رد می‌کنیم
# ساخت: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# آدرس https خودِ همین پروژه (برای ثبت خودکار وب‌هوک)
PUBLIC_APP_URL=https://ai-webhook-bot.vercel.app
# فقط این چت‌ها اجازه دارند ربات را کنترل کنند. خالی = همه (خطرناک)
# عدد را با فرستادن /id به ربات پیدا کن
TELEGRAM_ALLOWED_CHAT_IDS=
# بعد از هر استارت، وب‌هوک را خودکار ثبت کن
TELEGRAM_AUTO_SETUP=true
# ورود بدون رمز: هر چت باید شمارهٔ تلگرامش با «کاربران» سایت تطبیق داده شود
# (تلگرام خودش آن شماره را با پیامک تأیید کرده — پس پیامکِ اضافه لازم نیست)
TELEGRAM_REQUIRE_IDENTITY=false
