# ─────────────────────────────────────────────────────────────
#  OPENROUTER — مغزِ ربات (فقط مدل‌های :free)
#  لیست زندهٔ مدل‌های مجانی:  npm run models
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_TIMEOUT_MS=45000
MODEL_RETRIES=2

# ─────────────────────────────────────────────────────────────
#  انتخاب خودکارِ مدل
#  بات هر بار فهرست زندهٔ مدل‌های :free را می‌گیرد و بهترین‌ها را
#  بر اساس «کیفیت (جدولِ ما) + سرعتِ اندازه‌گیری‌شدهٔ خودش» می‌چیند.
# ─────────────────────────────────────────────────────────────
# auto = انتخاب از فهرست زنده (پیش‌فرض) · fixed = فقط همین لیستِ پایین
MODEL_SELECTION=auto
# چند مدل را به‌ترتیب امتحان کند
MODEL_POOL_SIZE=4
# مدل‌هایی با زمینهٔ کمتر از این را نادیده بگیر (گفت‌وگو با حافظه جا می‌خواهد)
MODEL_MIN_CONTEXT=8192
# مدلی که خطا داد چقدر قبلِ انتخابِ دوباره صبر کند
MODEL_COOLDOWN_MS=90000

# فقط «زنجیرهٔ پشتیبان»: وقتی فهرست زنده در دسترس نباشد استفاده می‌شود،
# و به‌عنوان مدل‌های مورد اعتمادِ تو کمی در رتبه‌بندی تقویت می‌شوند.
OPENROUTER_MODELS=liquid/lfm-3-1.7b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,google/gemma-4-26b-a4b-it:free

# ─────────────────────────────────────────────────────────────
#  شخصیت و حافظهٔ گفت‌وگو
# ─────────────────────────────────────────────────────────────
# اسمی که ربات برای خودش به کار می‌برد
BOT_NAME=نفَس
# وقتی می‌پرسند «تو کی هستی؟» چه بگوید: «من نفَس هستم، دستیار هوشمند <همین>»
CLINIC_NAME=کلینیک زیبایی نفس

# ─────────────────────────────────────────────────────────────
#  تاریخ و تقویم
#  سرور معمولاً UTC است؛ این منطقه برای «الان ساعت چنده» استفاده می‌شود
# ─────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Tehran
# خاموش کردن کاملِ لایهٔ تاریخ (true/false)
DATE_ASSISTANT=true
# زبان پیش‌فرض جواب‌ها: fa یا en (ربات همیشه به زبان خودِ کاربر جواب می‌دهد)
DEFAULT_LOCALE=fa
# چند پیامِ آخر در هر گفت‌وگو به‌عنوان زمینه به مدل داده شود
HISTORY_MESSAGES=12
# عمرِ حافظهٔ یک گفت‌وگو (میلی‌ثانیه) — پیش‌فرض ۳۰ دقیقه
HISTORY_TTL_MS=1800000
# نمونه‌گیری مدل
TEMPERATURE=0.7
MAX_TOKENS=700

# ─────────────────────────────────────────────────────────────
#  DATABASE — ذخیرهٔ تنظیمات (Postgres / Neon)
#  خالی بماند = بات بدون دیتابیس کار می‌کند، دقیقاً مثل قبل
# ─────────────────────────────────────────────────────────────
# رشتهٔ اتصال از داشبورد Neon. اگر از markdown کپی کردی و &amp; داشت،
# خودِ کد درستش می‌کند؛ channel_binding را هم نادیده می‌گیرد.
DATABASE_URL=

# تا وقتی شمارهٔ موبایلِ یک کاربر ذخیره نشده باشد، بات هیچ پیامی را جواب نمی‌دهد و یک بار
# شماره را می‌خواهد (از خودِ تلگرام، با دکمهٔ اشتراک شماره). فقط موبایل ایران، به شکل
# 09121234567. این gate فقط وقتی فعال است که DATABASE_URL تنظیم شده باشد؛ PHONE_GATE=off
# خاموشش می‌کند.
PHONE_GATE=on
# بعد از گذاشتنِ کلید، یک‌بار این را بزن تا جدول ساخته و اتصال تست شود:
#   npm run db:check

# ─────────────────────────────────────────────────────────────
#  محافظت از مسیر HTTP
# ─────────────────────────────────────────────────────────────
# اگر پر شود، /api/chat فقط با هدر x-bot-key (یا Bearer) جواب می‌دهد.
BOT_API_KEY=
# دامنه‌هایی که اجازهٔ صدا زدن از مرورگر دارند (CORS). با کاما. * = همه.
# صفحهٔ چتِ خودِ پروژه هم‌ریشه است و به این نیاز ندارد.
ALLOWED_ORIGINS=
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000
PUBLIC_APP_URL=https://nafas-chat-bot.vercel.app

# ─────────────────────────────────────────────────────────────
#  TELEGRAM — ربات تلگرام (اختیاری ولی پیشنهاد می‌شود)
#  ۱) در تلگرام به @BotFather پیام بده: /newbot
#  ۲) توکن را اینجا بگذار
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# یک رشتهٔ تصادفی؛ تلگرام در هر درخواست برمی‌گرداند و ما با آن جعلی‌ها را رد می‌کنیم
# ساخت: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# فقط این چت‌ها اجازه دارند با ربات حرف بزنند. خالی = همه (خطرناک)
# عدد را با فرستادن /id به ربات پیدا کن
TELEGRAM_ALLOWED_CHAT_IDS=
# بعد از هر استارت، وب‌هوک را خودکار ثبت کن
TELEGRAM_AUTO_SETUP=true
# فقط برای پراکسی سازمانی یا یک سرویس جعلی؛ در حالت عادی خالی بگذار
TELEGRAM_API_BASE=
