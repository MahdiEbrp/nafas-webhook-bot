{
  "name": "nafas-webhook-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Persian-first conversational chat bot: a Next.js backend for Vercel that answers over HTTP and Telegram using free OpenRouter models.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "users:test": "tsx scripts/users-contract-test.ts",
    "rules:test": "tsx scripts/rules-contract-test.ts",
    "working-hours:test": "tsx scripts/working-hours-test.ts",
    "social-links:test": "tsx scripts/social-links-test.ts",
    "clinic:test": "tsx scripts/clinic-operations-test.ts",
    "check": "tsc --noEmit && tsx scripts/selftest.ts && tsx scripts/clinic-operations-test.ts",
    "models": "tsx scripts/list-free-models.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "db:check": "tsx scripts/db-check.ts",
    "auth:check": "tsx scripts/auth-check.ts",
    "db:real": "tsx scripts/db-real.ts",
    "coverage": "c8 --experimental-monocart --all --include \"lib/users/**\" --exclude \"lib/users/types.ts\" --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 --reporter text tsx scripts/selftest.ts",
    "sms:test": "tsx scripts/sms-admin-test.ts",
    "settings:test": "tsx scripts/settings-admin-test.ts",
    "payment:test": "tsx scripts/payment-admin-test.ts",
    "email:test": "tsx scripts/email-admin-test.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@neondatabase/serverless": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "c8": "^12.0.0",
    "monocart-coverage-reports": "^2.13.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
