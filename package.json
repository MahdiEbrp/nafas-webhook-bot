{
  "name": "nafas-webhook-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Backend-only Next.js (Vercel) AI bot that talks to the clinic webhooks API using free OpenRouter models. Persian-speaking, kid-simple answers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "models": "tsx scripts/list-free-models.ts",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "mock-api": "node mock/webhooks-mock.mjs",
    "selftest": "tsx scripts/selftest.ts",
    "check": "tsc --noEmit && tsx scripts/selftest.ts",
    "doctor": "tsx scripts/doctor.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "telegram:mock": "node mock/telegram-mock.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
