{
  "name": "nafas-webhook-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Persian-first conversational chat bot: a Next.js backend for Vercel that answers over HTTP and Telegram using free OpenRouter models.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "check": "tsc --noEmit && tsx scripts/selftest.ts",
    "models": "tsx scripts/list-free-models.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:real": "tsx scripts/db-real.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@neondatabase/serverless": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
